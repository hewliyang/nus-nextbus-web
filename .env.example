# ─────────────────────────────────────────────────────────────────────────────
# NUS shuttle (uNivUS bus-proxy) configuration
#
# This repo is PUBLIC and intentionally ships NO reverse-engineered secrets.
# Copy to `.env` / set in Vercel + GitHub Actions. Values come from the uNivUS
# Android app (MITM / static analysis) — do not commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Host that serves /univus/api/bus-proxy/* and /univus/api/univus-public/* (inetapps).
NEXTBUS_BASE=""

# x-api-key for the ESB / Boomi front door.
NEXTBUS_API_KEY=""

# App version sent in every ESB body. Must be the full Android form the app uses:
#   univus_android_{versionName}_{versionCode}
# e.g. univus_android_2.60.8_147
# Bare semver (2.60.8) is normalized to univus_android_2.60.8_{NEXTBUS_APP_BUILD||999}.
# The build suffix is required — without it (or with a too-low code) upstream returns 10009.
# On 10009 the client re-scrapes Play Store for versionName and retries.
NEXTBUS_APP_VERSION=""

# Optional versionCode used when NEXTBUS_APP_VERSION is bare semver.
NEXTBUS_APP_BUILD=""

# Optional seed JWT. If unset/expired the client mints a PUBLIC guest token via
# POST /univus/api/univus-public/mobile/get-access-token and stores it in KV.
NEXTBUS_ESB_TOKEN=""

# Optional; filled from mint/refresh responses when omitted.
NEXTBUS_USER_ID=""

NEXTBUS_DEVICE_ID=""
NEXTBUS_USER_AGENT=""
NEXTBUS_IP_ADDR=""
NEXTBUS_DOMAIN=""

# Shared ESB JWT between the web app and the weekly scraper (Upstash / Vercel KV).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
